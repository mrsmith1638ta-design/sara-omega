<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SARA Companion"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Status" />
        <TextView
            android:id="@+id/statusValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not paired"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Device ID" />
        <TextView
            android:id="@+id/deviceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not assigned" />

        <EditText
            android:id="@+id/pairCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/pair_code_hint"
            android:inputType="textCapCharacters"
            android:maxLength="96" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pair_with_sara" />

        <Button
            android:id="@+id/checkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/check_now" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/send_now" />

        <Button
            android:id="@+id/unpairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/unpair" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Monitoring" />
        <TextView
            android:id="@+id/scheduleValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About every 15 minutes; Android may defer background work" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Last action" />
        <TextView
            android:id="@+id/lastActionValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="None yet" />
    </LinearLayout>
</ScrollView>
