SARA_PQC_CONSENSUS_STRICT=true
SARA_OPERATION_HMAC_SECRET=replace-with-aws-secrets-manager-value
SARA_CIPMU_SEAL_STORE=/var/lib/sara-cipmu/seal-store.json
SARA_CIPMU_SEAL_HMAC_KEY=replace-with-aws-secrets-manager-value
SARA_AWS_ROAD_ACCEPTANCE=PASS
SARA_AWS_PRODUCTION_ACCEPTED=true
SARA_AWS_ACCEPTANCE_SOURCE=aws-live-health-surface
SARA_AWS_ARTIFACT_SIGNING=PASS
SARA_AWS_ARTIFACT_SHA256=replace-with-64-character-artifact-sha256
SARA_AWS_SIGNATURE_REF=replace-with-kms-or-signing-evidence-reference
SARA_AWS_PROMOTION_AUTHORITY=APPROVED
SARA_AWS_PROMOTION_APPROVER=replace-with-authorized-approver
SARA_AWS_PROMOTION_SCOPE=replace-with-approved-release-scope
