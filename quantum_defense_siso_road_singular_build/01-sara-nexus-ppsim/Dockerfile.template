FROM __BASE_IMAGE__ AS oqs-builder
USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git libssl-dev ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 0.12.0 https://github.com/open-quantum-safe/liboqs /tmp/liboqs && \
    cmake -S /tmp/liboqs -B /tmp/liboqs/build -DBUILD_SHARED_LIBS=ON -DOQS_BUILD_ONLY_LIB=ON -DOQS_MINIMAL_BUILD="KEM_ml_kem_1024;SIG_ml_dsa_87" && \
    cmake --build /tmp/liboqs/build --parallel 4 && \
    cmake --install /tmp/liboqs/build
RUN git clone --depth 1 --branch 0.12.0 https://github.com/open-quantum-safe/liboqs-python /tmp/liboqs-python && \
    pip wheel --no-cache-dir /tmp/liboqs-python --wheel-dir /tmp/wheels

FROM __BASE_IMAGE__
USER root
WORKDIR /app
COPY --from=oqs-builder /usr/local/lib/ /usr/local/lib/
COPY --from=oqs-builder /usr/local/include/ /usr/local/include/
COPY --from=oqs-builder /tmp/wheels/ /tmp/wheels/
COPY requirements.txt .
RUN pip install --no-cache-dir /tmp/wheels/*.whl && pip install --no-cache-dir -r requirements.txt && rm -rf /tmp/wheels
COPY pqc_patch.py .
COPY main_patched.py .
ENV LD_LIBRARY_PATH=/usr/local/lib
ENV OQS_INSTALL_PATH=/usr/local
RUN ldconfig
RUN python -c "import oqs; assert 'ML-KEM-1024' in oqs.get_enabled_kem_mechanisms(); assert 'ML-DSA-87' in oqs.get_enabled_sig_mechanisms(); print(oqs.oqs_version(), oqs.oqs_python_version())"
ENV PORT=8080
EXPOSE 8080
CMD ["uvicorn", "main_patched:app", "--host", "0.0.0.0", "--port", "8080"]


