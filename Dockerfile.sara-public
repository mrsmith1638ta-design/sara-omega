FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-sara-public.txt ./requirements-sara-public.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-sara-public.txt

COPY sara_public.py ./sara_public.py

RUN python -m py_compile sara_public.py \
    && python sara_public.py --self-test

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD sh -c 'curl -fsS "http://127.0.0.1:${PORT:-8000}/health" >/dev/null || exit 1'

CMD ["python", "sara_public.py", "--serve"]
